{
  "name": "genesys-click-to-dial",
  "version": "1.0.0",
  "description": "A PWA for handling tel protocol with Genesys Cloud.",
  "main": "src/js/index.js",
  "scripts": {
    "build": "node esbuild.config.js",
    "dev": "esbuild src/js/index.js --bundle --outfile=dist/bundle.js --servedir=dist --watch=forever",
    "serve": "esbuild src/js/index.js --bundle --outfile=dist/bundle.js --servedir=dist",
    "http-serve": "http-server dist -c-1 -o",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:jest": "jest --coverage",
    "test:cypress": "start-server-and-test dev http://127.0.0.1:8000 cypress:run && nyc report --reporter=html",
    "cypress:run": "cypress run",
    "cypress:open": "cypress open",
    "coverage:merge": "node scripts/merge-coverage.js && nyc report"
  },
  "dependencies": {
    "esbuild": "^0.25.2",
    "purecloud-platform-client-v2": "^218.1.0",
    "vite": "^6.2.5"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@cypress/code-coverage": "^3.14.0",
    "@cypress/react": "^9.0.1",
    "@cypress/webpack-dev-server": "^4.0.2",
    "babel-jest": "^29.7.0",
    "babel-plugin-istanbul": "^7.0.0",
    "cypress": "^14.2.1",
    "http-server": "^14.1.1",
    "install": "^0.13.0",
    "istanbul": "^0.4.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "npm": "^11.2.0",
    "nyc": "^17.1.0",
    "start-server-and-test": "^2.0.11",
    "tree-kill": "^1.2.2"
  },
  "author": "Karl Hearne",
  "license": "MIT"
}
