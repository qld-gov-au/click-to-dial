{
  "name": "genesys-click-to-dial",
  "version": "1.0.0",
  "description": "A PWA for handling tel protocol with Genesys Cloud.",
  "main": "src/js/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "npx vite build --emptyOutDir",
    "dev": "npx vite dev",
    "serve": "npx serve dist",
    "http-serve": "http-server dist -c-1 -o",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:jest": "jest --coverage",
    "test:cypress": "start-server-and-test dev http://127.0.0.1:8000 cypress:run && nyc report --reporter=html",
    "cypress:run": "cypress run",
    "cypress:open": "cypress open",
    "coverage:merge": "node scripts/merge-coverage.js && nyc report"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "purecloud-platform-client-v2": "^218.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@cypress/code-coverage": "^3.14.0",
    "@cypress/react": "^9.0.1",
    "@cypress/webpack-dev-server": "^4.0.2",
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@esbuild-plugins/node-modules-polyfill": "^0.2.2",
    "@vitejs/plugin-react": "^4.4.1",
    "babel-jest": "^29.7.0",
    "babel-plugin-istanbul": "^7.0.0",
    "cypress": "^14.2.1",
    "http-server": "^14.1.1",
    "install": "^0.13.0",
    "istanbul": "^0.4.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "node-polyfill": "^1.0.0",
    "npm": "^11.2.0",
    "nyc": "^17.1.0",
    "start-server-and-test": "^2.0.11",
    "tree-kill": "^1.2.2",
    "vite": "^6.3.3",
    "vite-plugin-pwa": "^1.0.0",
    "esbuild": "^0.25.3",
    "vite-plugin-static-copy": "^2.3.1"
  },
  "author": "Karl Hearne",
  "license": "MIT"
}
